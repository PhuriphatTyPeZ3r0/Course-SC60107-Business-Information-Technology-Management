# Copy this file to `.env` (same folder as docker-compose.yaml) and fill in
# real values if you need something other than the defaults below. `.env` is
# gitignored - never commit real secrets.

# Postgres password for the `whisper` role (see docker-compose.yaml's
# postgres service). Defaults to "whisper" if unset - fine for local dev,
# change it for anything more than that.
POSTGRES_PASSWORD=

# Origin allowed to call this API cross-origin (CORSMiddleware in
# Process/Service.py). Defaults to the frontend's local dev server.
CORS_ORIGIN=http://localhost:3000
